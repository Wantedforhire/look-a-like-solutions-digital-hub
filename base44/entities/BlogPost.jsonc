{
  "type": "object",
  "name": "BlogPost",
  "properties": {
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Rich text / HTML content"
    },
    "coverImage": {
      "type": "string"
    },
    "coverImageAlt": {
      "type": "string",
      "description": "Alt text for the featured image"
    },
    "author": {
      "type": "string"
    },
    "authorRole": {
      "type": "string",
      "description": "Author role or area of expertise"
    },
    "authorBio": {
      "type": "string",
      "description": "Short author bio shown on the article page"
    },
    "lastReviewedDate": {
      "type": "string",
      "format": "date",
      "description": "Date the article was last reviewed for accuracy"
    },
    "publishDate": {
      "type": "string",
      "format": "date"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Original publication timestamp, preserved on edits"
    },
    "scheduledDate": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant the post goes live"
    },
    "scheduledTimezone": {
      "type": "string",
      "default": "Asia/Kolkata"
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "string"
    },
    "focusKeyword": {
      "type": "string"
    },
    "secondaryKeywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonicalUrl": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "string"
    },
    "ogImage": {
      "type": "string"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "scheduled",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "previousSlugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Old slugs that permanently redirect here"
    },
    "aiAssisted": {
      "type": "boolean",
      "default": false
    },
    "aiApproved": {
      "type": "boolean",
      "default": false
    },
    "aiApprovedBy": {
      "type": "string"
    },
    "aiApprovedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "slug",
    "title",
    "excerpt",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}