{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_sitemap_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_sitemap": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSitemap"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate sitemap",
            "description": "Query all public entities and write sitemap.xml"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "Asia/Calcutta",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Regenerates public/sitemap.xml every day at 2am IST with all published blog posts, insights, services, and case studies.",
  "name": "Daily Sitemap Refresh"
}